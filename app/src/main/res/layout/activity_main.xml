<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F19"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🏍️ OpenTripper Hunter 350"
        android:textColor="#38BDF8"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#151D2E"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/statusDot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="#EF4444" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Desconectado"
            android:textColor="#F1F5F9"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#0284C7"
            android:textColor="#FFFFFF"
            android:text="Conectar" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- PIN Group -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/pinInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="PIN"
                    android:inputType="number"
                    android:maxLength="6"
                    android:textAlignment="center"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#94A3B8" />

                <Button
                    android:id="@+id/btnSendPin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enviar PIN" />
            </LinearLayout>

            <!-- Manobras -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="MANOBRAS DE NAVEGAÇÃO"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_marginTop="4dp">

                <Button
                    android:id="@+id/btnLeft"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:text="⬅️ Esquerda" />

                <Button
                    android:id="@+id/btnRight"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:text="➡️ Direita" />

                <Button
                    android:id="@+id/btnStraight"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:text="⬆️ Reto" />

                <Button
                    android:id="@+id/btnRound"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:text="🔄 Rotatória" />
            </GridLayout>

            <!-- Funções Extras -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSyncClock"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="🕒 Relógio" />

                <Button
                    android:id="@+id/btnCall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="📞 Ligação" />
            </LinearLayout>

            <!-- Logs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="REGISTRO DE COMUNICAÇÃO"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCopyLogs"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋 Copiar" />
            </LinearLayout>

            <TextView
                android:id="@+id/logView"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="4dp"
                android:background="#070A11"
                android:fontFamily="monospace"
                android:padding="8dp"
                android:scrollbars="vertical"
                android:textColor="#38BDF8"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
